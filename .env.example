# InfiniteTag da loja, sem o "$". É o que identifica a vendedora na API de
# checkout da InfinitePay — que não usa header de autenticação, então este
# valor é a credencial. Nunca prefixar com NEXT_PUBLIC_: ele não pode ir para
# o navegador. O .gitignore já ignora .env*
INFINITEPAY_HANDLE=

# URL pública da loja. A InfinitePay usa para montar o redirect_url e o
# webhook_url, então em produção precisa ser o domínio real, com https.
# Em desenvolvimento o webhook não é enviado (localhost é inalcançável).
NEXT_PUBLIC_BASE_URL=http://localhost:3000
